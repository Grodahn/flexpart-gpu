# FLEXPART Fortran oracle image (RISK-03.3G-01).
#
# Builds the environment needed to compile the pinned, unmodified FLEXPART
# 11.1 sources (see reference/flexpart-11.1.json). The sources themselves are
# provided at run time via a bind mount (../flexpart -> /workspace/flexpart)
# and are never copied into the image, so the oracle revision stays exactly
# what `reference-check -- verify` approved.
#
# Build it with:
#   docker compose -f docker/docker-compose.fortran.yml build flexpart-fortran
FROM ubuntu:22.04@sha256:829f6df217bcbae2b371026e81711d1a787c61b2967ad09d015063663ebafbf7

# Ubuntu 22.04 apt >= 2.4.11 supports snapshot-pinned package resolution.
# Keep all pockets at the same timestamp (including security updates).
ARG UBUNTU_SNAPSHOT=20260910T000000Z

# The Ubuntu snapshot service redirects to HTTPS, so the digest-pinned
# base (which has no CA bundle) needs a narrowly scoped certificate bootstrap.
# Use ONLY Jammy's signed, immutable release pocket for that first install:
# no rolling updates/security pockets, no unverified TLS or moving package version.
RUN set -eux; \
  printf '%s\n' 'deb http://archive.ubuntu.com/ubuntu jammy main' > /tmp/ca-bootstrap.list; \
  apt-get update -o Dir::Etc::sourcelist=/tmp/ca-bootstrap.list -o Dir::Etc::sourceparts=-; \
  apt-get install -y --no-install-recommends \
    -o Dir::Etc::sourcelist=/tmp/ca-bootstrap.list -o Dir::Etc::sourceparts=- \
    ca-certificates=20211016; \
  rm /tmp/ca-bootstrap.list; \
  rm -rf /var/lib/apt/lists/*

# All subsequent package resolution, including the current pinned CA bundle,
# uses the same timestamped Ubuntu snapshot for every release/update pocket.
RUN set -eux; \
  sed -i -E "s#^deb http#deb [snapshot=${UBUNTU_SNAPSHOT}] http#" /etc/apt/sources.list; \
  grep -q "snapshot=${UBUNTU_SNAPSHOT}" /etc/apt/sources.list; \
  apt-get update; \
  apt-get install -y --no-install-recommends ca-certificates=20260601~22.04.1; \
  rm -rf /var/lib/apt/lists/*

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
  bash \
  curl \
  pkg-config \
  make \
  git \
  # Fortran toolchain
  gfortran \
  # Scientific I/O (ecCodes with Fortran interface, NetCDF C + Fortran)
  libeccodes-dev \
  libnetcdf-dev \
  libnetcdff-dev \
  # Python helpers (synthetic GRIB, ETEX parsing, comparisons)
  python3 \
  python3-numpy \
  python3-eccodes \
  && rm -rf /var/lib/apt/lists/*

LABEL org.opencontainers.image.ubuntu.snapshot="${UBUNTU_SNAPSHOT}"

# FLEXPART 11.1's makefile_gfortran consumes CPATH/LIBRARY_PATH and FC.
ENV FC=gfortran
ENV CPATH=/usr/include:/usr/include/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu/fortran/gfortran-mod-15
ENV LIBRARY_PATH=/usr/lib/x86_64-linux-gnu

WORKDIR /workspace/flexpart/src

CMD ["bash"]
