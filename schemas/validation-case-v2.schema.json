{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/validation-case-v2.schema.json",
  "title": "FLEXPART-GPU validation case manifest v2",
  "description": "Structural contract for Issue #51. Cross-field scientific invariants are enforced by src/validation/case.rs.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "$ref": "#/$defs/domain"
    },
    "release": {
      "$ref": "#/$defs/release"
    },
    "wind": {
      "$ref": "#/$defs/wind"
    },
    "surface": {
      "oneOf": [
        {
          "$ref": "#/$defs/surface"
        },
        {
          "type": "null"
        }
      ]
    },
    "integration": {
      "$ref": "#/$defs/integration"
    },
    "physics_switches": {
      "$ref": "#/$defs/physics_switches"
    },
    "simulation_direction": {
      "enum": [
        "forward",
        "backward"
      ]
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "deposition": {
      "$ref": "#/$defs/deposition"
    },
    "units": {
      "$ref": "#/$defs/units"
    },
    "validation_definition_refs": {
      "$ref": "#/$defs/validation_definition_refs"
    },
    "stochastic": {
      "$ref": "#/$defs/stochastic"
    },
    "execution_profile": {
      "$ref": "#/$defs/execution_profile"
    },
    "oracle_command_overrides": {
      "$ref": "#/$defs/oracle_command_overrides"
    },
    "expected_artifacts": {
      "$ref": "#/$defs/expected_artifacts"
    },
    "representation_differences": {
      "$ref": "#/$defs/representation_differences"
    },
    "require_source_containment": {
      "type": "boolean"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "output_grid": {
      "oneOf": [
        {
          "$ref": "#/$defs/output_grid"
        },
        {
          "type": "null"
        }
      ]
    },
    "candidate_physics_profile": {
      "$ref": "#/$defs/candidate_physics_profile"
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "description",
    "domain",
    "release",
    "wind",
    "integration",
    "physics_switches",
    "simulation_direction",
    "output",
    "units",
    "validation_definition_refs",
    "stochastic",
    "execution_profile",
    "candidate_physics_profile",
    "oracle_command_overrides",
    "expected_artifacts",
    "representation_differences",
    "require_source_containment",
    "notes"
  ],
  "$defs": {
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nx": {
          "type": "integer",
          "minimum": 1
        },
        "ny": {
          "type": "integer",
          "minimum": 1
        },
        "nz": {
          "type": "integer",
          "minimum": 1
        },
        "dx_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dy_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "xlon0_deg": {
          "type": "number"
        },
        "ylat0_deg": {
          "type": "number"
        },
        "horizontal_ref": {
          "const": "geographic_lon_lat_degrees"
        },
        "wind_heights_m": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number"
          }
        },
        "wind_heights_ref": {
          "enum": [
            "agl",
            "asl"
          ]
        }
      },
      "required": [
        "nx",
        "ny",
        "nz",
        "dx_deg",
        "dy_deg",
        "xlon0_deg",
        "ylat0_deg",
        "horizontal_ref",
        "wind_heights_m",
        "wind_heights_ref"
      ]
    },
    "point_geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "point"
        },
        "lon_deg": {
          "type": "number"
        },
        "lat_deg": {
          "type": "number"
        },
        "z_m": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "lon_deg",
        "lat_deg",
        "z_m"
      ]
    },
    "box_geometry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "box"
        },
        "lon_min_deg": {
          "type": "number"
        },
        "lon_max_deg": {
          "type": "number"
        },
        "lat_min_deg": {
          "type": "number"
        },
        "lat_max_deg": {
          "type": "number"
        },
        "z_min_m": {
          "type": "number"
        },
        "z_max_m": {
          "type": "number"
        }
      },
      "required": [
        "kind",
        "lon_min_deg",
        "lon_max_deg",
        "lat_min_deg",
        "lat_max_deg",
        "z_min_m",
        "z_max_m"
      ]
    },
    "source_geometry": {
      "oneOf": [
        {
          "$ref": "#/$defs/point_geometry"
        },
        {
          "$ref": "#/$defs/box_geometry"
        }
      ]
    },
    "instant_timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "instant"
        },
        "at": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14,
          "pattern": "^[0-9]{14}$"
        }
      },
      "required": [
        "kind",
        "at"
      ]
    },
    "window_timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "window"
        },
        "start": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14,
          "pattern": "^[0-9]{14}$"
        },
        "end": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14,
          "pattern": "^[0-9]{14}$"
        }
      },
      "required": [
        "kind",
        "start",
        "end"
      ]
    },
    "release_timing": {
      "oneOf": [
        {
          "$ref": "#/$defs/instant_timing"
        },
        {
          "$ref": "#/$defs/window_timing"
        }
      ]
    },
    "species": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "physics_contract": {
          "$ref": "#/$defs/species_physics_contract"
        }
      },
      "required": [
        "id",
        "physics_contract"
      ]
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "quantity_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "const": "kg"
        }
      },
      "required": [
        "quantity_kg",
        "unit"
      ]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "geometry": {
          "$ref": "#/$defs/source_geometry"
        },
        "vertical_ref": {
          "enum": [
            "agl",
            "asl"
          ]
        },
        "timing": {
          "$ref": "#/$defs/release_timing"
        },
        "species": {
          "$ref": "#/$defs/species"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "particle_count": {
          "type": "integer",
          "minimum": 1
        },
        "mass_kg_per_particle": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "geometry",
        "vertical_ref",
        "timing",
        "species",
        "inventory",
        "particle_count"
      ]
    },
    "met_transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "script": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "description",
        "script",
        "version"
      ]
    },
    "meteorology": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_path": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "temporal_coverage": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 14,
            "maxLength": 14,
            "pattern": "^[0-9]{14}$"
          }
        },
        "horizontal_coord": {
          "type": "string",
          "minLength": 1
        },
        "vertical_coord": {
          "type": "string",
          "minLength": 1
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidate_transformation": {
          "$ref": "#/$defs/met_transform"
        },
        "oracle_transformation": {
          "$ref": "#/$defs/met_transform"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "dataset_id",
        "version",
        "source_path",
        "digest",
        "temporal_coverage",
        "horizontal_coord",
        "vertical_coord",
        "required_fields",
        "candidate_transformation",
        "oracle_transformation"
      ]
    },
    "uniform_wind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "uniform"
        },
        "u_m_s": {
          "type": "number"
        },
        "v_m_s": {
          "type": "number"
        },
        "w_m_s": {
          "type": "number"
        }
      },
      "required": [
        "profile",
        "u_m_s",
        "v_m_s",
        "w_m_s"
      ]
    },
    "linear_shear_wind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "linear_shear"
        },
        "u0_m_s": {
          "type": "number"
        },
        "u_shear_per_s": {
          "type": "number"
        },
        "v_m_s": {
          "type": "number"
        },
        "w_m_s": {
          "type": "number"
        }
      },
      "required": [
        "profile",
        "u0_m_s",
        "u_shear_per_s",
        "v_m_s",
        "w_m_s"
      ]
    },
    "real_weather_wind": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "real_weather"
        },
        "meteorology": {
          "$ref": "#/$defs/meteorology"
        }
      },
      "required": [
        "profile",
        "meteorology"
      ]
    },
    "wind": {
      "oneOf": [
        {
          "$ref": "#/$defs/uniform_wind"
        },
        {
          "$ref": "#/$defs/linear_shear_wind"
        },
        {
          "$ref": "#/$defs/real_weather_wind"
        }
      ]
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "surface_pressure_pa": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "temperature_2m_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "dewpoint_2m_k": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sensible_heat_flux_w_m2": {
          "type": "number"
        },
        "solar_radiation_w_m2": {
          "type": "number"
        },
        "surface_stress_n_m2": {
          "type": "number"
        },
        "friction_velocity_m_s": {
          "type": "number"
        },
        "convective_velocity_scale_m_s": {
          "type": "number"
        },
        "mixing_height_m": {
          "type": "number"
        },
        "tropopause_height_m": {
          "type": "number"
        },
        "inv_obukhov_length_per_m": {
          "type": "number"
        },
        "precip_large_scale_mm_h": {
          "type": "number"
        },
        "precip_convective_mm_h": {
          "type": "number"
        },
        "u10_m_s": {
          "type": "number"
        },
        "v10_m_s": {
          "type": "number"
        }
      },
      "required": [
        "u10_m_s",
        "v10_m_s",
        "surface_pressure_pa",
        "temperature_2m_k",
        "dewpoint_2m_k",
        "sensible_heat_flux_w_m2",
        "solar_radiation_w_m2",
        "surface_stress_n_m2",
        "friction_velocity_m_s",
        "convective_velocity_scale_m_s",
        "mixing_height_m",
        "tropopause_height_m",
        "inv_obukhov_length_per_m",
        "precip_large_scale_mm_h",
        "precip_convective_mm_h"
      ]
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "string",
          "minLength": 14,
          "maxLength": 14,
          "pattern": "^[0-9]{14}$"
        },
        "dt_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 1
        },
        "steps": {
          "type": "integer",
          "minimum": 1
        },
        "total_s": {
          "type": "number",
          "exclusiveMinimum": 0,
          "multipleOf": 1
        }
      },
      "required": [
        "start",
        "dt_s",
        "steps",
        "total_s"
      ]
    },
    "physics_switches": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turbulence": {
          "type": "boolean"
        },
        "convection": {
          "type": "boolean"
        },
        "dry_deposition": {
          "type": "boolean"
        },
        "wet_deposition": {
          "type": "boolean"
        },
        "decay": {
          "type": "boolean"
        }
      },
      "required": [
        "turbulence",
        "convection",
        "dry_deposition",
        "wet_deposition",
        "decay"
      ]
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "interval_s": {
          "type": "integer",
          "minimum": 1
        },
        "averaging_window_s": {
          "type": "integer",
          "minimum": 1
        },
        "sampling_interval_s": {
          "type": "integer",
          "minimum": 1
        },
        "quantity": {
          "const": "time_averaged_mass_concentration_kg_m3"
        }
      },
      "required": [
        "interval_s",
        "averaging_window_s",
        "sampling_interval_s",
        "quantity"
      ]
    },
    "deposition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_deposition_velocity_m_s": {
          "type": "number",
          "minimum": 0
        },
        "dry_reference_height_m": {
          "type": "number",
          "minimum": 0
        },
        "wet_scavenging_coefficient_s_inv": {
          "type": "number",
          "minimum": 0
        },
        "wet_precipitating_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "dry_deposition_velocity_m_s",
        "wet_scavenging_coefficient_s_inv",
        "wet_precipitating_fraction"
      ]
    },
    "units": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wind": {
          "const": "m/s"
        },
        "displacement": {
          "type": "string"
        },
        "pressure": {
          "type": "string"
        },
        "temperature": {
          "type": "string"
        },
        "heat_flux": {
          "type": "string"
        },
        "height": {
          "type": "string"
        },
        "mass": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "shear": {
          "type": "string"
        },
        "inv_obukhov": {
          "type": "string"
        },
        "deposition_velocity": {
          "type": "string"
        },
        "scavenging_coefficient": {
          "type": "string"
        },
        "concentration": {
          "type": "string"
        }
      },
      "required": [
        "wind"
      ]
    },
    "validation_definition_ref": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "version",
        "path"
      ]
    },
    "validation_definition_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validation_definition_ref"
          }
        },
        "threshold_contracts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/validation_definition_ref"
          }
        }
      },
      "required": [
        "metric_contracts",
        "threshold_contracts"
      ]
    },
    "candidate_philox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "base_key": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "base_counter": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          }
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "derivation": {
          "enum": [
            "wrapping_add_key0_v1",
            "reuse_base_identity_v1"
          ]
        }
      },
      "required": [
        "base_key",
        "base_counter",
        "count",
        "derivation"
      ]
    },
    "oracle_strategy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "contract_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "strategy",
        "version",
        "contract_path"
      ]
    },
    "oracle_seed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "pristine-oracle",
            "seedable-validation-oracle"
          ]
        },
        "strategy": {
          "$ref": "#/$defs/oracle_strategy"
        },
        "seed": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000000
        },
        "repetitions": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "kind",
        "repetitions"
      ]
    },
    "stochastic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_philox": {
          "oneOf": [
            {
              "$ref": "#/$defs/candidate_philox"
            },
            {
              "type": "null"
            }
          ]
        },
        "oracle_seed": {
          "oneOf": [
            {
              "$ref": "#/$defs/oracle_seed"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "candidate_philox",
        "oracle_seed"
      ]
    },
    "execution_profile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "flexpart-11.1-single-thread"
        },
        "version": {
          "const": 1
        },
        "manifest_path": {
          "const": "reference/flexpart-11.1.json"
        }
      },
      "required": [
        "id",
        "version",
        "manifest_path"
      ]
    },
    "oracle_command_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "turbulence_formulation": {
          "enum": [
            "adaptive_w_sigw",
            "fixed_sync_w"
          ]
        },
        "lturbulence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "lconvection": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "ctl": {
          "type": "number"
        },
        "ifine": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "lsynctime_s": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "turbulence_formulation",
        "lturbulence",
        "lconvection",
        "ctl",
        "ifine",
        "lsynctime_s"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "turbulence_formulation": {
              "const": "adaptive_w_sigw"
            },
            "ctl": {
              "minimum": 0.1
            }
          },
          "required": [
            "turbulence_formulation",
            "ctl"
          ]
        },
        {
          "type": "object",
          "properties": {
            "turbulence_formulation": {
              "const": "fixed_sync_w"
            },
            "ctl": {
              "exclusiveMaximum": 0
            }
          },
          "required": [
            "turbulence_formulation",
            "ctl"
          ]
        }
