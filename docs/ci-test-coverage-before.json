    ".github/workflows/software-wgpu.yml": "name: Software WGSL smoke\n\non:\n  pull_request:\n  push:\n    branches: [main]\n\njobs:\n  software-wgpu:\n    runs-on: ubuntu-22.04\n    env:\n      FLEXPART_GPU_SOFTWARE: \"1\"\n      FLEXPART_GPU_CANDIDATE_REVISION: ${{ github.event.pull_request.head.sha || github.sha }}\n      WGPU_BACKEND: vulkan\n      LIBGL_ALWAYS_SOFTWARE: \"1\"\n",
    ".github/workflows/validation-gate.yml": "name: Technical validation gate\n\n# Small deterministic technical gate (RISK-03.3G-01, Issue #6 point 4).\n# Technical gate only: TECHNICAL_PASS does not establish scientific parity\n# and does not close Issue #6. The full ETEX mini run never executes here;\n# it stays local/manual (see extended-validation.yml and docs/ci-gates.md).\n\non:\n  pull_request:\n  push:\n    branches: [main]\n  workflow_dispatch:\n\njobs:\n  technical-gate:\n    runs-on: ubuntu-22.04\n    timeout-minutes: 60\n    env:\n      FLEXPART_GPU_SOFTWARE: \"1\"\n      WGPU_BACKEND: vulkan\n      LIBGL_ALWAYS_SOFTWARE: \"1\"\n"
  },
