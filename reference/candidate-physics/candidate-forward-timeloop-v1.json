{
  "id": "candidate-forward-timeloop-v1",
  "version": 1,
  "description": "Pinned candidate-side validation runner physics/runtime settings. Values preserve the effective pre-contract corpus behavior while removing dependence on Rust Default implementations and runner literals.",
  "time_bounds_behavior": "clamp",
  "integration": {
    "substeps_per_manifest_step": 1
  },
  "pbl_computation_options": {
    "roughness_length_m": 0.1,
    "wind_reference_height_m": 10,
    "heat_flux_neutral_threshold_w_m2": 1,
    "bulk_richardson_critical": 0.25,
    "min_shear_squared_m2_s2": 0.25,
    "fallback_mixing_height_m": 800,
    "hmix_min_m": 100,
    "hmix_max_m": 4500
  },
  "synthetic_meteorology": {
    "temperature_k": 285,
    "specific_humidity": 0.005,
    "pressure_pa": 100000,
    "air_density_kg_m3": 1.2,
    "density_gradient_kg_m2": -0.0008
  },
  "inactive_dry_reference_height_m": 15
}
